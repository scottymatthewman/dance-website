{
  "name": "dance-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:webpack": "node scripts/dev.mjs --webpack",
    "build": "node scripts/ensure-font-subset.mjs --quiet && node scripts/sync-public-asset-versions.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "subset-fonts": "node scripts/subset-fonts.mjs",
    "check-font-subset": "node scripts/check-font-subset.mjs",
    "check-font-subset:all": "node scripts/check-font-subset.mjs --all",
    "prepare": "sh scripts/install-githooks.sh",
    "knip": "knip",
    "compress-images": "node scripts/compress-public-images.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "16.2.6",
    "posthog-js": "^1.399.4",
    "posthog-node": "^5.41.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.17.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "agentation": "^3.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "knip": "^6.26.0",
    "playwright-core": "^1.61.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
