# Resend — form submission notifications
# https://resend.com/api-keys
RESEND_API_KEY=

# Must use an address on a domain verified in Resend
# e.g. Dance <notifications@usedance.com>
RESEND_FROM_EMAIL=

# Where signup notifications are delivered (defaults to hello@usedance.com)
# RESEND_TO_EMAIL=hello@usedance.com
